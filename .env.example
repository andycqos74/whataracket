# Copy to .env (never committed). The worker reads these at start-up.
# Workflow inputs and history must NEVER carry any of these values.

# --- Temporal ---------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=whataracket

# --- ClubSpark --------------------------------------------------------------
CLUBSPARK_HOST=clubspark.lta.org.uk
CLUBSPARK_VENUE=ParliamentHillFieldsTennisCourts
# LTA / British Tennis account used to sign in.
CLUBSPARK_USERNAME=
CLUBSPARK_PASSWORD=
# Role whose booking horizon applies (GetSettings Roles[].Name). Unset = shortest.
# CLUBSPARK_ROLE=Guest

# --- Payment card -----------------------------------------------------------
# Open decision (docs/DESIGN.md §6): how card details reach the checkout.
# Until it is decided, leave these empty — the build will not read them.
# CARD_NUMBER=
# CARD_EXPIRY=
# CARD_CVC=
# CARD_POSTCODE=

# --- Notifications ----------------------------------------------------------
# ntfy push to your phone (docs/DESIGN.md §7). Unset = notifications are only logged.
# Use a long random topic name: anyone who knows it can read it.
# NTFY_TOPIC_URL=https://ntfy.sh/<long-random-topic>
# NTFY_TOKEN=
